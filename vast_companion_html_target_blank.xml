<?xml version="1.0" encoding="UTF-8"?>
<!--
  テスト用VAST: HTMLコンパニオン広告 - target="_blank" / window.open() パターン
  companion内のリンクは新規ウィンドウを要求する形式(IMAの onCreateWindow / ポップアップWebView経路を通ることを狙う)
-->
<VAST version="3.0">
  <Ad id="test-companion-target-blank">
    <InLine>
      <AdSystem>TestAdSystem</AdSystem>
      <AdTitle>test companion ad (html target_blank)</AdTitle>
      <Description><![CDATA[HTML companion click test: target=_blank / window.open]]></Description>
      <Impression><![CDATA[https://example.com/track/impression?case=target_blank]]></Impression>
      <Creatives>
        <Creative id="linear-1" sequence="1">
          <Linear>
            <Duration>00:00:10</Duration>
            <TrackingEvents>
              <Tracking event="start"><![CDATA[https://example.com/track/start?case=target_blank]]></Tracking>
              <Tracking event="complete"><![CDATA[https://example.com/track/complete?case=target_blank]]></Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickThrough id="linear-clickthrough"><![CDATA[https://example.com/landing/linear?case=target_blank]]></ClickThrough>
            </VideoClicks>
            <MediaFiles>
              <MediaFile id="mp4-1" delivery="progressive" type="video/mp4" width="640" height="360" bitrate="500">
                <![CDATA[https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4]]>
              </MediaFile>
            </MediaFiles>
          </Linear>
        </Creative>
        <Creative id="companion-1" sequence="1">
          <CompanionAds>
            <Companion id="companion-target-blank" width="300" height="250">
              <HTMLResource><![CDATA[
<html>
  <head>
    <style>
      html, body { margin:0; padding:0; width:300px; height:250px; background:#1a73e8; }
      a.cta {
        display:flex; align-items:center; justify-content:center;
        width:100%; height:100%; color:#fff; font-family:sans-serif; font-size:20px;
        text-decoration:none;
      }
    </style>
  </head>
  <body>
    <!-- パターンA-1: target="_blank" 付きの通常リンク -->
    <a class="cta" href="https://example.com/landing/companion?case=target_blank_anchor" target="_blank">
      Learn More (target=_blank)
    </a>
    <!-- パターンA-2: window.open() をJSで明示的に呼ぶボタン(同じHTML内に両方置いておく) -->
    <script>
      function openViaJs() {
        window.open('https://example.com/landing/companion?case=window_open_js', '_blank');
      }
    </script>
  </body>
</html>
              ]]></HTMLResource>
              <TrackingEvents>
                <Tracking event="creativeView"><![CDATA[https://example.com/track/companion/creativeView?case=target_blank]]></Tracking>
              </TrackingEvents>
            </Companion>
          </CompanionAds>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
