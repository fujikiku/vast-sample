<?xml version="1.0" encoding="UTF-8"?>
<!--
  テスト用VAST: HTMLコンパニオン広告 - <a href="..."> のみ、target指定なしパターン
  companion内のリンクは同一WebView内での通常遷移を要求する形式
  (IMAがWebViewClientを設定していない場合の既定動作 = 案4 を狙って確認するためのテスト用)
-->
<VAST version="3.0">
  <Ad id="test-companion-no-target">
    <InLine>
      <AdSystem>TestAdSystem</AdSystem>
      <AdTitle>test companion ad (html no target)</AdTitle>
      <Description><![CDATA[HTML companion click test: plain <a href> with no target]]></Description>
      <Impression><![CDATA[https://example.com/track/impression?case=no_target]]></Impression>
      <Creatives>
        <Creative id="linear-1" sequence="1">
          <Linear>
            <Duration>00:00:10</Duration>
            <TrackingEvents>
              <Tracking event="start"><![CDATA[https://example.com/track/start?case=no_target]]></Tracking>
              <Tracking event="complete"><![CDATA[https://example.com/track/complete?case=no_target]]></Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickThrough id="linear-clickthrough"><![CDATA[https://example.com/landing/linear?case=no_target]]></ClickThrough>
            </VideoClicks>
            <MediaFiles>
              <MediaFile id="mp4-1" delivery="progressive" type="video/mp4" width="640" height="360" bitrate="500">
                <![CDATA[https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4]]>
              </MediaFile>
            </MediaFiles>
          </Linear>
        </Creative>
        <Creative id="companion-1" sequence="1">
          <CompanionAds>
            <Companion id="companion-no-target" width="300" height="250">
              <HTMLResource><![CDATA[
<html>
  <head>
    <style>
      html, body { margin:0; padding:0; width:300px; height:250px; background:#d93025; }
      a.cta {
        display:flex; align-items:center; justify-content:center;
        width:100%; height:100%; color:#fff; font-family:sans-serif; font-size:20px;
        text-decoration:none;
      }
    </style>
  </head>
  <body>
    <!-- パターンB: target属性を一切指定しない通常のリンク -->
    <a class="cta" href="https://example.com/landing/companion?case=no_target_anchor">
      Learn More (no target)
    </a>
  </body>
</html>
              ]]></HTMLResource>
              <TrackingEvents>
                <Tracking event="creativeView"><![CDATA[https://example.com/track/companion/creativeView?case=no_target]]></Tracking>
              </TrackingEvents>
            </Companion>
          </CompanionAds>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
